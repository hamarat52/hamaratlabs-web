# Cloudflare Pages başlık kuralları
# Oyunlar sık güncelleniyor: tarayıcı her açılışta sunucuya sorsun, değişmediyse 304 ile hızlı döner.
# (Alan adındaki 4 saatlik Browser Cache TTL eski sketch.js'in telefonda kalmasına yol açıyordu, 2026-11-05.)
/oyunlar/*
  Cache-Control: no-cache

# Kuveyt Türk okul projesi: sık güncelleniyor, eski CSS/JS telefonda kalmasın; .md dosyaları metin olarak açılsın
/okul-projeleri/kuveytturk-api-portal/*
  Cache-Control: no-cache
/okul-projeleri/kuveytturk-api-portal/docs/*.md
  Content-Type: text/markdown; charset=utf-8
/okul-projeleri/kuveytturk-api-portal/*.pdf
  X-Robots-Tag: noindex

# Fibi sunumunun PDF'i: tanıtım sayfasından indirilir, arama sonuçlarına girmez (sunum sayfası da noindex)
/okul-projeleri/fibi/*.pdf
  X-Robots-Tag: noindex

# KADER tarayıcıda oyna: emülatör ve oyun diski güncellenebilir; tarayıcı her açılışta sorsun (değişmediyse 304).
# Emülatör sayfası arama sonuçlarına girmez; yalnız aynı kökenden çerçevelenebilir.
/okul-projeleri/kader/oyna/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
/okul-projeleri/kader/oyna/*.wasm
  Content-Type: application/wasm
/okul-projeleri/kader/kader.dsk
  Cache-Control: no-cache

# Ma'shuk taslak sayfaları (v1/v2/v3): listelenmemiş önizleme, arama sonuçlarına girmez.
/mashuk/*
  X-Robots-Tag: noindex

# Beyzadem taslak sayfaları (v1/v2/v3): listelenmemiş önizleme, arama sonuçlarına girmez.
/beyzadem/*
  X-Robots-Tag: noindex
